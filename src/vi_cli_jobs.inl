// Observer commands create one bounded job and cancel that exact ID in all exits.
// A lost acknowledgement never causes the original hold to be repeated.
// Incomplete payloads are bytes, not validated UTF-8. Keep stdout ASCII-safe
// and reversible: decoded u00XX code points map back to the original bytes.
static std::string JobRawBytes(const std::string& bytes){std::string out;for(unsigned char byte:bytes){if(byte<0x20||byte>=0x7f){char escaped[7];sprintf_s(escaped,"\\u%04X",byte);out+=escaped;}else{if(byte=='"'||byte=='\\')out+='\\';out+=(char)byte;}}return out;}
static bool BoundedJobRequest(DWORD pid,const std::string& request,DWORD budget,std::string& response,size_t maxResponseBytes=65536){
 return BoundedCliRequest(pid,request,budget,response,nullptr,maxResponseBytes);
}
// Select top-level protocol fields without matching text inside a JSON string.
// This is a bounded field selector, not a replacement for the target JSON parser.
static bool JobString(const std::string& text,size_t& at,std::string& value){if(at>=text.size()||text[at++]!='"')return false;while(at<text.size()){char c=text[at++];if(c=='"')return true;if(c=='\\'){if(at>=text.size())return false;c=text[at++];if(c=='u'){if(at+4>text.size())return false;unsigned cp=0;for(int n=0;n<4;n++){char digit=text[at++];if(digit>='0'&&digit<='9')cp=cp*16+digit-'0';else if(digit>='a'&&digit<='f')cp=cp*16+digit-'a'+10;else if(digit>='A'&&digit<='F')cp=cp*16+digit-'A'+10;else return false;}value+=cp<128?(char)cp:'?';continue;}if(c=='n')c='\n';else if(c=='r')c='\r';else if(c=='t')c='\t';else if(c=='b')c='\b';else if(c=='f')c='\f';}value+=c;}return false;}
static bool JobField(const std::string& text,const char* wanted,char& kind,std::string& value){size_t at=0;auto ws=[&](){while(at<text.size()&&isspace((unsigned char)text[at]))++at;};ws();if(at>=text.size()||text[at++]!='{')return false;bool found=false;for(;;){ws();if(at<text.size()&&text[at]=='}')return found;std::string key;if(!JobString(text,at,key))return false;ws();if(at>=text.size()||text[at++]!=':')return false;ws();if(at>=text.size())return false;const char type=text[at];std::string field;if(type=='"'){if(!JobString(text,at,field))return false;}else{size_t start=at;int depth=0;bool quoted=false,escaped=false;while(at<text.size()){char c=text[at];if(quoted){if(escaped)escaped=false;else if(c=='\\')escaped=true;else if(c=='"')quoted=false;}else if(c=='"')quoted=true;else if(c=='['||c=='{')++depth;else if(c==']'||c=='}'){if(!depth)break;--depth;}else if(c==','&&!depth)break;++at;}field=text.substr(start,at-start);while(!field.empty()&&isspace((unsigned char)field.back()))field.pop_back();}if(key==wanted){found=true;kind=type;value=field;}ws();if(at>=text.size())return false;if(text[at]=='}')return found;if(text[at++]!=',')return false;}}
static Reply RequireInputJobs(DWORD pid){std::string response,ok,jobs,detail;char okType=0,jobsType=0,errorType=0;const bool received=BoundedJobRequest(pid,"{\"cmd\":\"jobs\"}",750,response,512*1024);if(received&&JobField(response,"ok",okType,ok)&&okType=='t'&&ok=="true"&&JobField(response,"jobs",jobsType,jobs)&&jobsType=='[')return {true,"{\"ok\":true}"};if(received)JobField(response,"error",errorType,detail);else detail="input-job support probe transport/deadline failure";if(detail.empty())detail="target does not support input jobs; restart the owned target with the matching updated DLL";return {false,"{\"ok\":false,\"input_injected\":false,\"job_support_checked\":true,\"error\":\""+JEsc(detail)+"\",\"support_response\":"+"null"+",\"support_raw\":\""+JobRawBytes(response)+"\",\"raw_encoding\":\"json-u00-byte-escapes\"}"};}
static bool NeedsInputJobs(const std::string& payload){char kind=0;std::string cmd,buttons,unused;if(!JobField(payload,"cmd",kind,cmd))return true;JobField(payload,"buttons",kind,buttons);for(char& c:buttons)c=(char)tolower((unsigned char)c);if(cmd=="up"||cmd=="release"||cmd=="mouseup"||(cmd=="pad"&&buttons=="off"))return false;return (cmd=="key"||cmd=="hold"||cmd=="pad"||cmd=="pulse"||cmd=="pad-ramp"||cmd=="pad-timeline")&&(JobField(payload,"async",kind,unused)||JobField(payload,"replace",kind,unused));}
static Reply CmdHoldWhile(DWORD pid,const Args& a,bool pad){
 if(a.pos.size()!=1)return Fail("hold-while needs one key/chord (pad-hold-while needs one button list)");
 unsigned timeout=5000;if(HasOpt(a,"timeout-ms")&&(!ExpectUnsigned(GetOpt(a,"timeout-ms"),118000,timeout)||timeout<100))return Fail("--timeout-ms must be100..118000");
 const std::string text=GetOpt(a,"until-text");if(text.empty()||text.size()>512)return Fail("--until-text needs1..512 bytes");
 Args query;query.pos.push_back(text);query.opt.push_back({"timeout",std::to_string(timeout)});
 for(const auto& option:a.opt){if(option.first=="until-text"||option.first=="timeout-ms")continue;if(pad&&(option.first=="lx"||option.first=="ly"||option.first=="rx"||option.first=="ry"||option.first=="lt"||option.first=="rt"))continue;
  if(option.first!="region"&&option.first!="exact"&&option.first!="fuzzy"&&option.first!="any")return Fail("unsupported hold-while option --"+option.first);query.opt.push_back(option);}
 TextQuery parsed;std::string error;if(!ParseTextQuery(query,"wait-text",parsed,error))return Fail(error);
 Reply support=RequireInputJobs(pid);if(!support.ok)return support;
 std::vector<std::string> original={pad?"pad":"hold",a.pos[0],std::to_string(timeout+1000),"--async"};if(pad)for(const auto& option:a.opt)if(option.first=="lx"||option.first=="ly"||option.first=="rx"||option.first=="ry"||option.first=="lt"||option.first=="rt"){original.push_back("--"+option.first);original.push_back(option.second);}
 std::string command,ack;if(!BuildJson(original,command,error))return Fail(error);const bool received=BoundedJobRequest(pid,command,1500,ack);const std::string id=JsonText(ack,"job_id");
 if(!received||ack.find("\"ok\":true")==std::string::npos||id.empty())return {false,std::string("{\"ok\":false,\"input_injected\":null,\"delivery_unknown\":true,\"error\":\"hold acknowledgement unavailable; no input was retried; any accepted job retains its target-side hard deadline\",\"input\":")+(received&&!ack.empty()?ack:"null")+",\"input_raw\":\""+JobRawBytes(ack)+"\",\"raw_encoding\":\"json-u00-byte-escapes\"}"};
 struct Cancel{DWORD pid;std::string id,response;bool attempted=false,received=false,confirmed=false;void Run(){if(attempted)return;attempted=true;received=BoundedJobRequest(pid,"{\"cmd\":\"job-cancel\",\"id\":\""+JEsc(id)+"\"}",1000,response);confirmed=received&&response.find("\"ok\":true")!=std::string::npos;}~Cancel(){try{Run();}catch(...){}}} cleanup{pid,id,{}};
 const ULONGLONG start=GetTickCount64(),deadline=start+timeout;Reply observed=Fail("hold never reached a ready state");bool ready=false;
 for(;;){std::string status;if(!BoundedJobRequest(pid,"{\"cmd\":\"job-status\",\"id\":\""+JEsc(id)+"\"}",(DWORD)(std::min)(500ULL,deadline>GetTickCount64()?deadline-GetTickCount64():0ULL),status))break;
  if(status.find("\"hold_ready\":true")!=std::string::npos){ready=true;break;}if(status.find("\"job_complete\":true")!=std::string::npos||GetTickCount64()>=deadline)break;Sleep(2);
 }
 if(ready){std::string status;bool timedOut=false;double first=0,last=0;bool fresh=ExpectStatus(pid,(DWORD)(deadline>GetTickCount64()?(std::min)(500ULL,deadline-GetTickCount64()):0),status,error,timedOut);if(fresh){first=last=JsonNum(status,"frames");if(first>0){while(last-first<2&&GetTickCount64()<deadline){Sleep(2);if(!ExpectStatus(pid,(DWORD)(deadline>GetTickCount64()?(std::min)(500ULL,deadline-GetTickCount64()):0),status,error,timedOut)){fresh=false;break;}last=JsonNum(status,"frames");}fresh=fresh&&last-first>=2;}else Sleep((DWORD)(std::min)(100ULL,deadline>GetTickCount64()?deadline-GetTickCount64():0ULL));}
  if(fresh&&GetTickCount64()<deadline){for(auto& option:query.opt)if(option.first=="timeout")option.second=std::to_string(deadline-GetTickCount64());observed=CmdText(pid,query,1);}else observed=Fail("fresh post-hold observation unavailable before deadline");}
 // Job states are monotonic: a terminal/canceled job cannot resume. A fresh
 // same-ID running/ready snapshot after OCR confirms it survived the observer.
 std::string holdStatus;const bool holdStatusReceived=BoundedJobRequest(pid,"{\"cmd\":\"job-status\",\"id\":\""+JEsc(id)+"\"}",500,holdStatus);
 const bool maintained=ready&&holdStatusReceived&&JsonText(holdStatus,"job_id")==id&&JsonText(holdStatus,"job_state")=="running"&&holdStatus.find("\"hold_ready\":true")!=std::string::npos&&holdStatus.find("\"job_complete\":false")!=std::string::npos;
 cleanup.Run();const bool ok=observed.ok&&maintained&&cleanup.confirmed;
 return {ok,std::string("{\"ok\":")+(ok?"true":"false")+",\"job_id\":\""+JEsc(id)+"\",\"hold_ready\":"+(ready?"true":"false")+",\"hold_maintained\":"+(maintained?"true":"false")+",\"hold_status\":"+(holdStatusReceived&&!holdStatus.empty()?holdStatus:"null")+",\"hold_status_raw\":\""+JobRawBytes(holdStatus)+"\""+",\"expectation_met\":"+(observed.ok?"true":"false")+",\"cleanup_confirmed\":"+(cleanup.confirmed?"true":"false")+",\"input\":"+ack+",\"expectation\":"+observed.json+",\"cleanup\":"+(cleanup.received&&!cleanup.response.empty()?cleanup.response:"null")+",\"cleanup_raw\":\""+JobRawBytes(cleanup.response)+"\""+(maintained?"":",\"error\":\"held input ended before observation completed or continuity could not be confirmed\"")+",\"raw_encoding\":\"json-u00-byte-escapes\",\"evidence\":\"text is observed state, not causal proof; original input was not retried; target deadline remains independent of this observer\"}"};
}
